# PF-05 local Founder preview only. Copy to .env.local; do not use hosted Firebase values.
VITE_FIREBASE_API_KEY=preview-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-tiizi-pf05-preview
VITE_FIREBASE_STORAGE_BUCKET=demo-tiizi-pf05-preview.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:preview0000000000

# Explicitly opt in to loopback Firebase emulators. Off/absent leaves SDKs normal.
VITE_FIREBASE_USE_EMULATORS=true
VITE_TIIZI_API_ENABLED=true
VITE_TIIZI_API_BASE_URL=http://localhost:4000
VITE_TIIZI_V2_CHALLENGES_ENABLED=true
