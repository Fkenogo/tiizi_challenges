# Tiizi API env (local development — never commit real secrets)
PORT=4000
DATABASE_URL=postgresql://tiizi:tiizi@localhost:5432/tiizi

# Firebase project whose ID tokens the API accepts (Phase A: token issuer only).
FIREBASE_PROJECT_ID=your-project-id
# Service-account credentials for local shadow import / parity CLIs only.
# The API request path verifies tokens via the Admin SDK default credentials chain.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Local PostgreSQL for the API itself is configured only via DATABASE_URL above.
