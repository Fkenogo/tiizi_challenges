# Tiizi API env (local development — never commit real secrets)
PORT=4000
DATABASE_URL=postgresql://tiizi:tiizi@localhost:5432/tiizi
# For managed PostgreSQL, append TLS: postgresql://user:pass@host:5432/tiizi?sslmode=require

# Firebase project whose ID tokens the API accepts.
FIREBASE_PROJECT_ID=your-project-id
# Service-account credentials for local tooling (shadow import / parity CLIs) only.
# The API request path verifies tokens via Application Default Credentials, which
# also honors this variable locally. Cloud Run uses workload identity instead —
# never deploy service-account JSON with the container.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Comma-separated exact origins allowed to call the API cross-origin.
# Empty = same-origin only (never a wildcard). Production must set this explicitly.
# Example: TIIZI_ALLOWED_ORIGINS=https://tiizi.example,https://www.tiizi.example
# Local web dev: TIIZI_ALLOWED_ORIGINS=http://localhost:5173
TIIZI_ALLOWED_ORIGINS=http://localhost:5173

# Max PostgreSQL connections per API instance. Total connections ≈
# (Cloud Run max instances) × TIIZI_DB_POOL_MAX — keep both bounded (default 5, max 50).
TIIZI_DB_POOL_MAX=5

# Local PostgreSQL for the API itself is configured only via DATABASE_URL above.
