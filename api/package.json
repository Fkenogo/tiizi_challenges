{
  "name": "tiizi-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Provider-neutral Tiizi Application API (Phase A foundation).",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/migrateCli.ts",
    "shadow:import": "tsx src/shadowImportCli.ts",
    "parity:memberships": "tsx src/parityCli.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "firebase-admin": "^13.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.0",
    "tsx": "^4.20.3",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
